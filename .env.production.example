# Homi – production settings for docker-compose.yml. Copy to `.env` next to docker-compose.yml.
# Never commit the real file.

# Public URL users open (no trailing slash). Must match exactly what is in the browser address bar:
#   local test:  http://localhost:3000
#   LAN test:    http://192.168.1.20:3000   (iPhone on the same Wi-Fi)
#   internet:    https://homi.example.ch    (behind an HTTPS reverse proxy, see README)
APP_URL=http://localhost:3000

# At least 32 random characters:
#   openssl rand -base64 48      or
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Database credentials (PostgreSQL runs inside the compose network only).
# The password is embedded in a postgresql:// URL, so use URL-safe characters only (letters and digits):
#   openssl rand -hex 24      or
#   node -e "console.log(require('node:crypto').randomBytes(24).toString('hex'))"
# It is applied when the database volume is first created; changing it later does not change the stored password.
POSTGRES_USER=homi
POSTGRES_PASSWORD=
POSTGRES_DB=homi

# Port on the host (and bind address; use 127.0.0.1 when a reverse proxy runs on the same host)
HOMI_PORT=3000
HOMI_BIND=0.0.0.0

# Image tag on ghcr.io/julianhintermann-cmd/homi (latest, sha-<commit>, or a release like 1.0.0)
HOMI_IMAGE_TAG=latest

# Secure cookies: auto = only when APP_URL starts with https:// ; true / false to force
COOKIE_SECURE=auto
# Behind a reverse proxy: the number of proxy hops, normally 1. Avoid "true": it trusts the left-most
# X-Forwarded-For entry, which any client can write itself (per-IP rate limits could be bypassed).
TRUST_PROXY=false

# false closes public sign-up (private instance: create the accounts first, then set it to false)
REGISTRATION_ENABLED=true

# Optional – password reset by e-mail
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=false
