# Homi – environment variables (docs/ARCHITECTURE.md §2).
# Copy to `.env` in the repository root for local development: `cp .env.example .env`
# Never commit real secrets. All values below are safe development defaults.

# development | production | test
NODE_ENV=development

# HTTP server
PORT=3000
HOST=0.0.0.0

# Public origin of the app (no trailing slash). Used for the CSRF/Origin check and for
# invitation / password-reset links. In development this is the Vite dev server.
# REQUIRED in production, e.g. https://homi.example.ch
APP_URL=http://localhost:5173

# PostgreSQL (docker compose -f docker-compose.dev.yml up -d)
DATABASE_URL=postgresql://homi:homi@localhost:5432/homi
# Separate database for integration tests (it is truncated between test files!)
DATABASE_URL_TEST=postgresql://homi:homi@localhost:5432/homi_test

# HMAC key for session/invitation/reset token hashing.
# REQUIRED in production, at least 32 characters. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
# Leave empty in development to use an insecure built-in dev secret.
SESSION_SECRET=

# Session lifetime in days (sliding expiry)
SESSION_TTL_DAYS=30

# Uploaded images (relative paths are resolved against the server's working directory).
# Docker: /data/uploads (persistent volume)
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=15

# Session cookie Secure flag: auto = only when APP_URL starts with https:// (default); true / false force it
COOKIE_SECURE=auto

# Set to true (or the number of proxy hops) when running behind a reverse proxy
TRUST_PROXY=false

# Outgoing mail for password resets – leave SMTP_HOST empty to disable password reset by mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Homi <no-reply@example.ch>"
# true for implicit TLS (port 465), false for STARTTLS (port 587)
SMTP_SECURE=false

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Built SPA served in production (default: apps/web/dist relative to apps/server)
# WEB_DIST_DIR=/app/apps/web/dist
